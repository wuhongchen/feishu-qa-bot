# Feishu QA Bot environment variables

# Required: Feishu app credentials
FEISHU_APP_ID=cli_xxxxxxxxxxxxx
FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Required for writing to Bitable
QA_BITABLE_TOKEN=
QA_TABLE_ID=
# Optional: you can provide base URL directly, app token will be auto parsed
# Example: https://t0woxppdywz.feishu.cn/base/RQLIbiG3VaIg0rsZxezcKTaMnwf?from=from_copylink
QA_BITABLE_BASE_URL=https://t0woxppdywz.feishu.cn/base/RQLIbiG3VaIg0rsZxezcKTaMnwf?from=from_copylink
# Optional: if QA_TABLE_ID is empty, try matching this table name (else fallback first table)
QA_TABLE_NAME=

# Required: monitored chat IDs, comma-separated
QA_CHAT_ID=oc_xxxxxxxxxxxxx,oc_yyyyyyyyyyyy

# Optional: human-readable names map (chat_id:name)
QA_CHAT_NAMES=oc_xxxxxxxxxxxxx:工具组,oc_yyyyyyyyyyyy:学员交流群

# Optional behavior switches
ADMIN_USER_ID=ou_xxxxxxxxxxxxx
QA_ENABLE_NPS=true
QA_MAX_ROUNDS=0
QA_SESSION_TTL_MINUTES=30
QA_PROCESS_WINDOW_MINUTES=5
QA_MSG_DEDUP_CACHE_FILE=/tmp/feishu_qa_processed_messages.json
QA_MSG_DEDUP_TTL_MINUTES=120
QA_INTENT_BACKLOG_FILE=/Users/hongchen/Downloads/code/feishu-qa-bot/backups/intent_backlog.json

# Optional token cache file
FEISHU_TOKEN_CACHE_FILE=/tmp/feishu_app_token.json

# Optional: knowledge base sync settings
# Source can be:
# 1) local JSON path
# 2) JSON URL returning array / {"intents":[...]}
# 3) Feishu Wiki URL (auto merge snippets into existing intents)
QA_KB_SOURCE=https://waytoagi.feishu.cn/wiki/WewVwPVkyipyaCka7twcwPZMnJf
QA_KB_TARGET=/Users/hongchen/Downloads/code/openclaw/feishu_qa_bot_skill/intents.json
QA_KB_BACKUP_DIR=/Users/hongchen/Downloads/code/openclaw/feishu_qa_bot_skill/backups
QA_KB_TIMEOUT=15
QA_KB_STRICT=true
# Optional JSON headers for URL source
# QA_KB_SOURCE_HEADERS={"Authorization":"Bearer xxx"}
# Optional: sync current intents snapshot into Bitable table
QA_SYNC_INTENTS_TO_BITABLE=true

# Optional: unmatched fallback via scoped AI search (default on with OpenClaw)
QA_ENABLE_AI_FALLBACK=true
QA_AI_SEARCH_PROVIDER=openclaw
QA_OPENCLAW_SEARCH_AGENT=main
# Optional: if provider=tavily
QA_TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx
QA_AI_SEARCH_ALLOWED_DOMAINS=waytoagi.feishu.cn,t0woxppdywz.feishu.cn,docs.openclaw.ai,openclaw.ai,clawhub.com
QA_AI_SEARCH_MAX_RESULTS=3
QA_AI_SEARCH_TIMEOUT=10
QA_AI_SEARCH_DEPTH=basic
QA_AI_FALLBACK_MIN_CHARS=4
# CSV regex list. short chit-chat can be skipped to keep old silent behavior
QA_AI_FALLBACK_SKIP_PATTERNS=^\\s*(你好|hello|hi|在吗)\\s*[!！。.,，]?\\s*$,^\\s*(谢谢|感谢|辛苦了)\\s*[!！。.,，]?\\s*$
# CSV keyword list. hit these keywords -> refuse with boundary notice
QA_AI_FALLBACK_BLOCKED_KEYWORDS=医疗,诊断,处方,法律,诉讼,判刑,股票,买币,投资建议,政治立场,密码,token,密钥,越狱,注入
